# 새 서버용 설정 이름 목록(값 없음). 값은 지금 Streamlit Cloud의 App settings → Secrets에 있는 값을 그대로 옮긴다.
# 이 파일을 복사한 app.env 에 값을 채우고 서버에서만 보관(chmod 600). 저장소·채팅·메일에 값을 남기지 않는다.
# Fly.io: fly secrets import < app.env   /   Lightsail: /opt/gosomi/app.env

# ── 연결(필수) ──
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
# 주소가 바뀌면 함께 바꿔야 하는 값(전환 때만, docs/server-migration-plan.md)
APP_BASE_URL=
GOOGLE_OAUTH_REDIRECT_URL=
NAVER_LOGIN_START_URL=

# ── 운영자·방침 ──
PRIVACY_POLICY_ENABLED=
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_EFFECTIVE_DATE=
PRIVACY_POLICY_UPCOMING_DATE=
TERMS_V2_UPCOMING_DATE=
MIN_USER_AGE=
TERMS_EFFECTIVE_DATE_V2=

# ── 로그인 ──
GOOGLE_LOGIN_ENABLED=
NAVER_LOGIN_ENABLED=
EMAIL_SIGNUP_ENABLED=
PASSWORD_RESET_ENABLED=

# ── 기능 스위치(지금 운영값을 그대로: AI 멈춤 등) ──
AI_FEATURES_PAUSED=
AI_CALLS_PER_HOUR=
AI_CALLS_PER_HOUR_TOTAL=
EVIDENCE_UPLOAD_ENABLED=
DRAFT_SAVE_ENABLED=
CASE_WORKSPACE_SAVE_ENABLED=
VOICE_INPUT_ENABLED=
AI_CHAT_V2_ENABLED=
VOICE_CHAT_ENABLED=
VOICE_SERVER_TTS_ENABLED=
GEMINI_TTS_MODEL=
ASSIST_V2_ENABLED=
LAW_OPEN_API_OC=
ADMIN_USER_IDS=

# ── 결제(판매 전, 지금 값 그대로) ──
BILLING_MODE=
BILLING_PLANS_JSON=

# ── 쓰지 않음 ──
# AUTH_IP_FORWARDING_ENABLED= (꺼짐 유지)
# SUPABASE_SECRET_KEY= (2026-10-12 운영에서 제거. 새 서버에도 넣지 않는다)
