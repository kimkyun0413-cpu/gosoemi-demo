# Copy to .env on the server (chmod 600). Never commit real values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOSOMI_DOMAIN=gosomi.ai.kr
APP_BASE_URL=https://gosomi.ai.kr
GOOGLE_OAUTH_REDIRECT_URL=https://gosomi.ai.kr
# Safe initial deployment: no paid calls and no ordinary-user AI launch.
AI_FEATURES_PAUSED=true
AI_PUBLIC_LAUNCH_ENABLED=false
AI_PAID_TIER_VERIFIED=false
AI_HOSTING_VERIFIED=false
AI_USAGE_DB_ENABLED=false
DRAFT_ATOMIC_SAVE_ENABLED=false
AI_USAGE_SERVICE_KEY=
AI_CALLS_PER_HOUR=30
AI_CALLS_PER_HOUR_TOTAL=300
AI_CALLS_PER_DAY=100
AI_CALLS_PER_DAY_TOTAL=2000
EMAIL_SIGNUP_ENABLED=false
PASSWORD_RESET_ENABLED=false
MIN_USER_AGE=14
# Preserve current dates until reviewed rollout. Never set an arbitrary effective date.
TERMS_EFFECTIVE_DATE_V2=
PRIVACY_POLICY_ENABLED=true
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_EFFECTIVE_DATE=2026-09-27
ADMIN_USER_IDS=
BILLING_MODE=off
