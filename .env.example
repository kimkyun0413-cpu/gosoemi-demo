# 새 서버용 설정 목록. 서버에서 이 파일을 .env 로 복사해 채우고(chmod 600) 서버에만 둔다. 실제 값은 저장소·채팅·메일에 남기지 않는다.
# 값 규칙: 따옴표 없이 이름=값. 빈 칸은 지금 Streamlit Cloud의 App settings → Secrets 값을 그대로 옮긴다
# (비워 두면 그 기능이 꺼진다: 예) NAVER_* 를 비우면 네이버 로그인이 사라짐).
# 값이 미리 적힌 줄은 '안전한 시작값'이다: AI·일반 공개·새 DB 기능은 꺼진 채로 시작한다.

# ── 주소 (도메인 gosomi.ai.kr) ──
GOSOMI_DOMAIN=gosomi.ai.kr
# 시험 배포 때는 운영 주소 그대로, 전환 때만 새 주소로 바꾼다(docs/server-migration-plan.md)
APP_BASE_URL=
GOOGLE_OAUTH_REDIRECT_URL=
NAVER_LOGIN_START_URL=

# ── 연결 (Streamlit Secrets 값 그대로) ──
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=

# ── 운영자·방침·연령 (Streamlit Secrets 값 그대로) ──
PRIVACY_POLICY_ENABLED=
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_EFFECTIVE_DATE=
PRIVACY_POLICY_UPCOMING_DATE=
MIN_USER_AGE=
TERMS_EFFECTIVE_DATE_V2=
TERMS_V2_UPCOMING_DATE=

# ── 로그인 (Streamlit Secrets 값 그대로) ──
GOOGLE_LOGIN_ENABLED=
NAVER_LOGIN_ENABLED=
EMAIL_SIGNUP_ENABLED=false
PASSWORD_RESET_ENABLED=false

# ── AI: 안전한 시작값(유료 전환·18세·방침 v3·서버·사용량 DB가 모두 갖춰지기 전에는 일반 이용자 AI 없음) ──
AI_FEATURES_PAUSED=true
AI_PUBLIC_LAUNCH_ENABLED=false
AI_PAID_TIER_VERIFIED=false
AI_HOSTING_VERIFIED=false
AI_USAGE_DB_ENABLED=false
AI_USAGE_SERVICE_KEY=
AI_CALLS_PER_HOUR=30
AI_CALLS_PER_HOUR_TOTAL=300
AI_CALLS_PER_DAY=100
AI_CALLS_PER_DAY_TOTAL=2000

# ── 기능 스위치 (Streamlit Secrets 값 그대로) ──
EVIDENCE_UPLOAD_ENABLED=
DRAFT_SAVE_ENABLED=
DRAFT_ATOMIC_SAVE_ENABLED=false
CASE_WORKSPACE_SAVE_ENABLED=
VOICE_INPUT_ENABLED=
AI_CHAT_V2_ENABLED=
VOICE_CHAT_ENABLED=
VOICE_SERVER_TTS_ENABLED=
ASSIST_V2_ENABLED=
LAW_OPEN_API_OC=
ADMIN_USER_IDS=

# ── 결제(판매 전) ──
BILLING_MODE=off
BILLING_PLANS_JSON=

# ── 쓰지 않음 ──
# AUTH_IP_FORWARDING_ENABLED= (꺼짐 유지)
# SUPABASE_SECRET_KEY= (2026-10-12 운영에서 제거. 새 서버에도 넣지 않는다)
